@echo off
REM Starts every app of this project for the current phase and opens the web apps in a browser.
REM Generated by the dev-pipeline toolkit (/run-kit); safe to double-click. Options: -DryRun -NoBrowser -Only id,id -Reinstall
setlocal
cd /d "%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0run\start.ps1" %*
set RC=%ERRORLEVEL%
echo.
if not "%RC%"=="0" echo Start did not complete. Read the message above.
echo The apps run in their own windows. Use stop.cmd to stop them.
pause
endlocal & exit /b %RC%
