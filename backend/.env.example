# backend/.env.example - copy to backend/.env (git-ignored) or let scripts/setup_db.ps1 write it for you.
# Placeholders only. Never commit real values. Every key of app/core/config.py Settings is listed here.

# development | test | production
APP_ENV=development

# App role created by scripts/setup_db.ps1 (PostgreSQL 17 on port 5442). URL-encode special characters in the password.
DATABASE_URL=postgresql+asyncpg://mitali_app:CHANGE_ME@localhost:5442/mitali_portfolio
TEST_DATABASE_URL=postgresql+asyncpg://mitali_app:CHANGE_ME@localhost:5442/mitali_portfolio_test

# Folders (relative paths are relative to backend/)
MEDIA_ROOT=media
FRONTEND_DIST_DIR=../frontend/dist

# true only for the production-like preview (FastAPI serves frontend/dist)
SERVE_FRONTEND=false

# Exact scheme://host:port origins, comma separated (no *, no null)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# false over plain http on localhost; must be true when APP_ENV=production
SESSION_COOKIE_SECURE=false

# At least 32 random characters, e.g.: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
HASH_KEY_SECRET=CHANGE_ME_generate_a_random_value_of_at_least_32_chars

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
