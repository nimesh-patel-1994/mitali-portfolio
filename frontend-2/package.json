{
  "name": "mitali-portfolio-frontend-2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "fonts": "tsx scripts/copy-fonts.ts",
    "predev": "npm run fonts",
    "dev": "vite",
    "generate:api": "openapi-typescript ../docs/api-contract.yaml -o src/api/schema.d.ts",
    "lint": "eslint . && npm run check:styles",
    "check:styles": "tsx scripts/check-styles.ts",
    "check:motion-size": "tsx scripts/check-motion-size.ts",
    "check:dist": "tsx scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prebuild": "npm run fonts",
    "build": "npm run build:client && npm run build:ssr && npm run check:dist",
    "build:client": "tsc --noEmit && vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.2",
    "@tanstack/react-query": "5.105.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@fontsource/antonio": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.32",
    "postcss-custom-media": "12.0.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
